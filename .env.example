# Supabase (required)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key (preferred; bypasses RLS so the backend can write/delete)
SUPABASE_SECRET=your-service-role-key
# Anon key (only used if SUPABASE_SECRET is empty)
SUPABASE_KEY=

# Required to delete songs / reset the catalog. Pick a long random string.
# The frontend must send the same value as the ADMIN_TOKEN it forwards.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Storage bucket names (Supabase Storage; used only if R2 is NOT configured)
UPLOADS_BUCKET=uploads
OUTPUTS_BUCKET=outputs

# Cloudflare R2 (recommended): free egress. If set, files are stored/served from
# R2 instead of Supabase Storage. Get these from the Cloudflare R2 dashboard.
# The Access Key ID / Secret come from "Manage R2 API Tokens" (Object Read & Write).
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET=karaoke-media
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Groq Speech-to-Text (optional but recommended). If set, transcription runs on
# Groq's hosted Whisper Large v3 instead of the local model: faster, frees RAM,
# and better lyrics. Leave empty to use the local Whisper model.
# Get the key at https://console.groq.com (Create API Key).
GROQ_API_KEY=
# whisper-large-v3 (max accuracy, default) or whisper-large-v3-turbo (faster)
GROQ_WHISPER_MODEL=whisper-large-v3

# Models (defaults shown). htdemucs = lighter 4-stem model.
# WHISPER_MODEL is only used as the LOCAL fallback when GROQ_API_KEY is empty.
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=es

# Set true to load models at startup (uses RAM immediately)
PRELOAD_MODELS=false

# Optional: point heavy caches to a drive with space
# TORCH_HOME=D:\\caches\\torch
# XDG_CACHE_HOME=D:\\caches\\xdg
